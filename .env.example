# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=
# Shown on the thank-you page. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (ReSub's own payments; connected to TrustMRR).
# Leave both secret vars empty and the page runs waitlist-only (founding spots hidden).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Phase 2 reminders; optional owner alerts in Phase 1)
RESEND_API_KEY=
# Where signup alerts go. Without a verified domain, must be your Resend account email.
OWNER_EMAIL=
# Leave empty until tryresub.com is verified in Resend (defaults to onboarding@resend.dev).
RESEND_FROM=

# Encryption key for merchant API keys stored at rest (Phase 2)
ENCRYPTION_KEY=
